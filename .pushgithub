# This script initializes the git repository, adds all files, and pushes to GitHub.
# Make sure you have created your repository on GitHub first, then run this file or copy-paste these commands into your terminal.

# 1. Initialize the git repository if not already done
git init

# 2. Add all your re-organized files
git add .

# 3. Commit your changes
git commit -m "Initial commit: Ready for Vercel deployment with Supabase integration"

# 4. Link to your GitHub repository (REPLACE THE URL BELOW WITH YOUR ACTUAL GITHUB REPO URL)
# Example: git remote add origin https://github.com/yourusername/debt-collector.git
# git remote add origin <YOUR_GITHUB_REPO_URL>

# 5. Push your code to the main branch
# git branch -M main
# git push -u origin main
